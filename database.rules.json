{
  "rules": {
    ".read": false,
    ".write": false,

    "roster": {
      ".read": true,
      "$cls": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'badim1aaa@gmail.com')",
          ".validate": "newData.hasChildren(['name', 'login']) && newData.child('name').isString() && newData.child('name').val().length <= 30"
        }
      }
    },

    "users": {
      ".read": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'badim1aaa@gmail.com')"
      }
    },
    "public": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'badim1aaa@gmail.com')" }
    },
    "pins": {
      ".read": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'badim1aaa@gmail.com')",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
      }
    },
    "progress": {
      ".read": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "attempts": {
      ".read": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$attempt": { ".write": "auth != null && auth.uid === $uid && !data.exists()" }
      }
    },
    "mistakes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'badim1aaa@gmail.com'"
    },
    "presence": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "online": {
      ".read": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "live": {
      ".read": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$q": {
          ".write": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
          "ans": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['oral', 'at']) && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 500))"
          }
        }
      }
    },
    "quest": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      "$q": {
        "stations": {
          "$s": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'at']) && newData.child('uid').val() === auth.uid"
          }
        },
        "players": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "done": {
          ".write": "auth != null && !data.exists() && root.child('quest/' + $q + '/stations').hasChildren(['s1', 's2', 's3', 's4', 's5', 's6'])",
          ".validate": "newData.hasChildren(['uid', 'name', 'at']) && newData.child('uid').val() === auth.uid"
        }
      }
    },
    "chat": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'badim1aaa@gmail.com'",
      ".indexOn": ["t"],
      "$msg": {
        ".write": "auth != null && !data.exists() && root.child('settings/chatEnabled').val() === true",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 120"
      }
    }
  }
}
